400,"season":null,"episode":null}]},"x9bb546ce93":{"show_id":"x9bb546ce93","tmdb_id":null,"content_type":"program","title":"One Love","title_en":null,"title_fr":null,"original_title":null,"tagline":null,"description":"\"شراب التوت (One Love)\" مسلسل درامي تركي عن امرأة عصرية مثالية تُدعى شيرين، تربّي ابنتيها وفقاً لمعتقداتها وقيمها الخاصة. ابنتها الصغرى بيسان لا تزال في المرحلة الثانوية، بينما تدرس ابنتها الكبرى رلى طب الأسنان في الجامعة. تواجه شيرين صراعاً كبيراً عندما تتزوج رلى من رجل يُدعى فاتح ينتمي إلى عائلة متديّنة ومحافظة—عائلة تتعارض قيمها بشدة مع مُثُل شيرين. ومع محاولة العائلتين التعايش، تتصاعد التوترات. وتخلق الاختلافات في المعتقدات والتوقعات والتقاليد دراما متواصلة. وتبدأ الأسرار وصراعات النفوذ والاضطرابات العاطفية بالتكشّف، لتضع الولاءات والحب ومتانة الروابط العائلية على المحك. إنها قصة عن الحب وصدام الثقافات وصراع الأجيال، وعن المدى الذي قد يذهب إليه المرء لحماية عائلته ومبادئه.","description_en":"","description_fr":"","poster":null,"backdrop":null,"has_poster":false,"rating":null,"vote_count":null,"age_rating":null,"year":null,"release_date":null,"runtime_minutes":null,"status":null,"country":null,"language":null,"genres":[],"genre_keys":[],"similar":[],"director":null,"cast":[],"trailer_url":null,"seasons_count":null,"episodes_count":null,"all_airings":[{"channel_id":"MTV.lb@SD","start":"2026-11-16T18:30:00Z","stop":"2026-11-16T19:30:00Z","start_ts":1794853800,"stop_ts":1794857400,"season":null,"episode":null},{"channel_id":"MTV.lb@SD","start":"2026-11-17T18:30:00Z","stop":"2026-11-17T20:00:00Z","start_ts":1794940200,"stop_ts":1794945600,"season":null,"episode":null},{"channel_id":"MTV.lb@SD","start":"2026-11-18T18:30:00Z","stop":"2026-11-18T19:30:00Z","start_ts":1795026600,"stop_ts":1795030200,"season":null,"episode":null}]},"x91ff3b618a":{"show_id":"x91ff3b618a","tmdb_id":null,"content_type":"program","title":"Mesh Masrahiyeh","title_en":null,"title_fr":null,"original_title":null,"tagline":null,"description":"\"مش مسرحية\" منصة شبابية تجمع أصواتاً 