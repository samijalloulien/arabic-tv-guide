"https://image.tmdb.org/t/p/w500/sdUhNi4kLlnK7vkr8wsy40NoLZL.jpg","backdrop":"https://image.tmdb.org/t/p/w780/qdlGMNU47u56v0OKxpnCjWRz8PA.jpg","has_poster":true,"rating":null,"vote_count":null,"age_rating":null,"year":"1982","release_date":"1982-05-17","runtime_minutes":null,"status":"Released","country":"مصر","language":"العربية","genres":["كوميديا","دراما","عائلي"],"genre_keys":["comedy","drama","family"],"similar":["mv56334","mv415813","mv106646","mv194","mv493623","mv603661","mv116745","mv10830"],"director":"يحيى العلمي","cast":[{"name":"سمير غانم","character":null,"profile_image":"https://image.tmdb.org/t/p/w185/vSqmd98zrxOAnDFnBGnt4Wihn7B.jpg"},{"name":"يونس شلبي","character":null,"profile_image":"https://image.tmdb.org/t/p/w185/jLtc7MnYVPHGdIyIhKeVESVdpb7.jpg"},{"name":"إسعاد يونس","character":null,"profile_image":"https://image.tmdb.org/t/p/w185/jP7Sc5tSneEBTmni0npq87obq1g.jpg"},{"name":"وحيد سيف","character":null,"profile_image":"https://image.tmdb.org/t/p/w185/eDLRmet0ePsP3GPN05wy4f6uxrS.jpg"},{"name":"معالي زايد","character":null,"profile_image":"https://image.tmdb.org/t/p/w185/oAALG7p4ReXhOgtZQehCtYcfkR1.jpg"},{"name":"محمد رضا","character":null,"profile_image":"https://image.tmdb.org/t/p/w185/c45atsICuA4BShxcd8qIGOHp2QU.jpg"},{"name":"مريم فخر الدين","character":null,"profile_image":"https://image.tmdb.org/t/p/w185/xrJVs2VO7HjOkYWpuKBtEI2mpuU.jpg"},{"name":"عمر الحريري","character":null,"profile_image":"https://image.tmdb.org/t/p/w185/2UjTbJxOgc96wpO8zTzCgSu1Puf.jpg"},{"name":"سهير زكي","character":null,"profile_image":"https://image.tmdb.org/t/p/w185/pKciGe6ID4RVowtrRIcQbyQxVAf.jpg"},{"name":"زكريا موافي","character":null,"profile_image":"https://image.tmdb.org/t/p/w185/1BJq6QhQedGVa3QSDnkm4v6izFU.jpg"}],"trailer_url":"https://www.youtube.com/watch?v=yhXeH_RsSg0","seasons_count":null,"episodes_count":null,"all_airings":[{"channel_id":"RotanaComedy.sa@SD","start":"2026-11-29T10:00:00Z","stop":"2026-11-29T12:00:00Z","start_ts":1795946400,"stop_ts":1795953600,"season":null,"episode":null}]},"mv48651":{"show_id":"mv48651","tmdb_id":48651,"content_type":"movie","title":"حاحا وتفاحة","title_en":"Haha W Tofaha","title_fr":null,"original_title":null,"tagline":null,"description":"(حاحا) نبطشي أفراح، بينما تعمل شقيقته (تفاحة) ممرضة في إحدى المستشفيات، يدور الصراع بينهما حول إمتلاك المنزل الذي يسكناه، حيث يسعى (حاحا) للزواج فيه، أما (تفاحة) فتسعى للزواج من (فوزي) بائع الأنابيب بينما (حاحا) يرفض هذا الزواج، وتمر الأحداث إلى أن يكتشفا أن الأخوة أسمى من أن يعكرها أي صراع.","description_en":"In a house the popular area, Abdeen, live Haha and his sister, Tuffaha, Haha works as \"Nubachi\" whose duty is to collect gift money thrown at belly dancers, at wedding parties, from under the dancers, while Tuffaha works as a nurse in a hospital. A conflict arises between them about who gets to keep the family home, as Haha wants to get married a live in it, and Tuffaha is in love with Fawzi, a gas cylinder mobile salesman, and wants to marry him and live in family home, but Haha disapproves this relationship.","description_fr":"","poster":"https://image.tmdb.org/t/p/w500/4bS2Af3FDSiZZKsv4fEPvmbvIew.jpg","backdrop":"https://image.tmdb.org/t/p/w780/srdgOnQxFC2FIAvXFMem3wslHEF.jpg","has_poster":true,"rating":5,"vote_count":22,"age_rating":"PG-13","year":"2005","release_date":"2005-12-31","runtime_minutes":104,"status":"Released","country":"مصر","language":"العربية","genres":["كوميديا","مغامرة"],"genre_keys":["comedy","adventure"],"similar":["mv436969","mv116745","mv287947","mv696506","mv448119","mv620240","mv10137","mv10996"],"director":"أكرم فريد","cast":[{"name":"طلعت زكريا","character":"حاحا","profile_image":"https://image.tmdb.org/t/p/w185/9eC3kDLAzhlPI9MqqgXrIiaMEEQ.jpg"},{"name":"ياسمين عبدالعزيز","character":"تفاحة","profile_image":"https://image.tmdb.org/t/p/w185/6WevW0u4fa47n5NSSps18leaPep.jpg"},{"name":"حسن حسني","character":null,"profile_image":"https://image.tmdb.org/t/p/w185/vMG9Carh5bi18v5unk06aYvvKZw.jpg"},{"name":"Riko","cha