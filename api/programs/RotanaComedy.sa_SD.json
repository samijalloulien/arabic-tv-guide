y that lies at the very heart of this light-hearted drama.","description_fr":"","poster":"https://image.tmdb.org/t/p/w500/mp6PDqcdVFNxDbODQ9CJeM0lf8A.jpg","backdrop":"https://image.tmdb.org/t/p/w780/cAjf1lh5roaig8WzgzgkgtOALIr.jpg","has_poster":true,"rating":7.9,"vote_count":12,"age_rating":null,"year":"2021","release_date":"2021-12-09","runtime_minutes":101,"status":"Released","country":"مصر","language":"العربية","genres":["دراما","كوميديا"],"genre_keys":["drama","comedy"],"similar":["mv106646","mv194","mv493623","mv603661","mv116745","mv9390","mv330493","mv279498"],"director":"عمرو سلامة","cast":[{"name":"عمر شريف","character":null,"profile_image":"https://image.tmdb.org/t/p/w185/iSiOazDKO0tIChVnn79oJJGYTHp.jpg"},{"name":"ماجد الكدواني","character":null,"profile_image":"https://image.tmdb.org/t/p/w185/iBOBl5XrufQr67yqUU7YOUXoY54.jpg"},{"name":"روبي","character":null,"profile_image":"https://image.tmdb.org/t/p/w185/oHnmUfGuJuNdS2QcoZlKUZwfHAi.jpg"},{"name":"دنيا ماهر","character":null,"profile_image":"https://image.tmdb.org/t/p/w185/y4lVAb0EBl5M1sCIeATftZzbi2G.jpg"},{"name":"أحمد خالد صالح","character":null,"profile_image":"https://image.tmdb.org/t/p/w185/oh1ng5yRPv56h6tXza661BMR1G3.jpg"},{"name":"أحمد أمين","character":null,"profile_image":"https://image.tmdb.org/t/p/w185/b22RdCDUrUEmD1g8X1gkHqF9q1U.jpg"},{"name":"أسماء أبو اليزيد","character":null,"profile_image":"https://image.tmdb.org/t/p/w185/qM9mfKLafVZQoPSi9BlqZjDLYCK.jpg"},{"name":"أمجد الحجار","character":null,"profile_image":"https://image.tmdb.org/t/p/w185/b2s7mv4t3OIzftJWGGfhNAjLbc3.jpg"},{"name":"Mohamed Diab","character":null,"profile_image":"https://image.tmdb.org/t/p/w185/iFWDvhdabtcelzGMneMPbcBFdw7.jpg"},{"name":"Ahmed Abdel Hadi","character":null,"profile_image":null}],"trailer_url":"https://www.youtube.com/watch?v=yCgqex7tiCQ","seasons_count":null,"episodes_count":null,"all_airings":[{"channel_id":"RotanaComedy.sa@SD","start":"2026-11-29T14:00:00Z","stop":"2026-11-29T16:00:00Z","start_ts":1795960