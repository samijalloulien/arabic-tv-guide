ants, where a false identity becomes the only shield in the battle for survival.","description_fr":"","poster":"https://image.tmdb.org/t/p/w500/4Qbffql5vv9BE6lGPdERmT97iuV.jpg","backdrop":"https://image.tmdb.org/t/p/w780/fxXZn4Xm6ZxwqX3zgDm2lpuqVqs.jpg","has_poster":true,"rating":null,"vote_count":null,"age_rating":null,"year":"2026","release_date":"2026-02-18","runtime_minutes":null,"status":"Ended","country":"سوريا","language":"العربية","genres":[],"genre_keys":[],"similar":[],"director":null,"cast":[{"name":"سامر المصري","character":null,"profile_image":"https://image.tmdb.org/t/p/w185/fTejJQh10ydJRf2RLat0R7qB5da.jpg"},{"name":"ديمة قندلفت","character":null,"profile_image":"https://image.tmdb.org/t/p/w185/4RRk5nHvs2SijmgPxTUWCYo4d2A.jpg"},{"name":"محمد حداقي","character":null,"profile_image":"https://image.tmdb.org/t/p/w185/8aPZ2jzyWX4irsCtoMf07WpcEb4.jpg"},{"name":"فادي صبيح","character":null,"profile_image":"https://image.tmdb.org/t/p/w185/sT8eh6gx7DHa4RGuC69HV50YMHW.jpg"},{"name":"نادين تحسين بيك","character":null,"profile_image":"https://image.tmdb.org/t/p/w185/vUwsBAExr8vimdS7l95YyB0drOe.jpg"},{"name":"رامز الأسود","character":null,"profile_image":null},{"name":"فايز قزق","character":null,"profile_image":"https://image.tmdb.org/t/p/w185/8ZYqGM2cXlzDQE9G4h22y8WzhM9.jpg"},{"name":"حسين عباس","character":null,"profile_image":"https://image.tmdb.org/t/p/w185/fTFnU3J5o9w3qC5VdkuWbTdH2Ue.jpg"},{"name":"غزوان الصفدي","character":null,"profile_image":"https://image.tmdb.org/t/p/w185/98R4ZB1YbRoPTSQgPegWbpQmEWu.jpg"},{"name":"طارق مرعشلي","character":null,"profile_image":"https://image.tmdb.org/t/p/w185/6LCFXQ8Quj9qy60WX2jj5kelWQJ.jpg"}],"trailer_url":null,"seasons_count":1,"episodes_count":30,"all_airings":[{"channel_id":"RoyaTV.jo@SD","start":"2026-11-16T21:00:00Z","stop":"2026-11-16T21:30:00Z","start_ts":1794862800,"stop_ts":1794864600,"season":null,"episode":null},{"channel_id":"LanaTV.lb@SD","start":"2026-11-17T18:00:00Z","stop":"2026-11-17T19:00:00Z","start_ts"