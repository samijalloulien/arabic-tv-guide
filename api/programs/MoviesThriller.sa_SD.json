05:31:50Z","start_ts":1795319210,"stop_ts":1795325510,"season":null,"episode":null},{"channel_id":"MoviesThriller.sa@SD","start":"2026-11-22T11:01:50Z","stop":"2026-11-22T12:46:50Z","start_ts":1795345310,"stop_ts":1795351610,"season":null,"episode":null}]},"mv14574":{"show_id":"mv14574","tmdb_id":14574,"content_type":"movie","title":"The Boy","title_en":"The Boy in the Striped Pyjamas","title_fr":"Le Garçon au pyjama rayé","original_title":"The Boy in the Striped Pyjamas","tagline":null,"description":"تقبل جريتا العمل كمربية ولكنها سرعان ما تكتشف أن ابن العائلة ذا الثماني سنوات ليس إلا دمية بالحجم البشري يقوم الوالدان بالاعتناء به وكأنه صبي حقيقي.","description_en":"When his family moves from their home in Berlin to a strange new house in Poland, young Bruno befriends Shmuel, a boy who lives on the other side of the fence where everyone seems to be wearing striped pajamas. Unaware of Shmuel's fate as a Jewish prisoner or the role his own Nazi father plays in his imprisonment, Bruno embarks on a dangerous journey inside the camp's walls.","description_fr":"Seconde Guerre mondiale. Bruno a tout juste 9 ans lorsque son père, un officier nazi remarqué par le Führer, se voit confier le commandement du camp de concentration polonais d'Auschwitz. Le petit garçon n'apprécie guère de devoir quitter la belle et grande maison de Berlin pour se retrouver dans une demeure isolée et triste. De sa chambre, il aperçoit des hommes, des femmes et des enfants tous vêtus de pyjamas rayés. Personne ne lui explique qui ils sont, mais l'innocence aidant, il va se lier d'amitié avec un enfant juif…","poster":"https://image.tmdb.org/t/p/w500/2C8QCXdMlojTxZjfBlINr4FWcb6.jpg","backdrop":"https://image.tmdb.org/t/p/w780/6aRuABAdhuuDypLGscM7HoEWHx4.jpg","has_poster":true,"rating":7.8,"vote_count":7944,"age_rating":"PG-13","year":"2008","release_date":"2008-05-07","runtime_minutes":95,"status":"Released","country":"المملكة المتحدة","language":"الإنجليزية","genres":["دراما","حرب","تاريخ","رعب","إ