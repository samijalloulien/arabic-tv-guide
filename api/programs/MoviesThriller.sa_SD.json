mv106646","tmdb_id":106646,"content_type":"movie","title":"The Wolf Of Wall Street","title_en":null,"title_fr":"Le Loup de Wall Street","original_title":null,"tagline":"اكسب. أنفق. احتفل.","description":"في أوج صعوده إلى قمة النجاح، يكتسب شاب يعمل في البورصة، متعطش لحياة مليئة بالإثارة، لقب ذئب وول ستريت.","description_en":"A New York stockbroker refuses to cooperate in a large securities fraud case involving corruption on Wall Street, corporate banking world and mob infiltration. Based on Jordan Belfort's autobiography.","description_fr":"Sa licence de courtier en poche, et les narines déjà pleines de cocaïne, Jordan Belfort est prêt à conquérir Wall Street. Ce jour d'octobre, un krach, le plus important depuis 1929, vient piétiner ses rêves de grandeur. C'est finalement à Long Island qu'il échoue et qu'il monte sa propre affaire de courtage. Son créneau : le hors-cote. Sa méthode : l'arnaque. Son équipe : des vendeurs ou des petits trafiquants.","poster":"https://image.tmdb.org/t/p/w500/dthIkG1QqqVZhXWnVHgLCf2KvXH.jpg","backdrop":"https://image.tmdb.org/t/p/w780/7Nwnmyzrtd0FkcRyPqmdzTPppQa.jpg","has_poster":true,"rating":8,"vote_count":26974,"age_rating":"R","year":"2013","release_date":"2013-12-25","runtime_minutes":180,"status":"Released","country":"الولايات المتحدة","language":"الإنجليزية","genres":["جريمة","دراما","كوميديا","سيرة ذاتية","كوميدي"],"genre_keys":["crime","drama","comedy","history"],"similar":["mv396371","mv1016084","mv1242419","mv446791","mv381284","mv530915","mv359724","mv313369"],"director":"مارتن سكورسيزي","cast":[{"name":"ليوناردو دي كابريو","character":"Jordan Belfort","profile_image":"https://image.tmdb.org/t/p/w185/wo2hJpn04vbtmh0B9utCFdsQhxM.jpg"},{"name":"جونا هيل","character":"Donnie Azoff","profile_image":"https://image.tmdb.org/t/p/w185/cymlWttB83MsAGR2EkTgANtjeRH.jpg"},{"name":"مارجو روبي","character":"Naomi Lapaglia","profile_image":"https://image.tmdb.org/t/p/w185/euDPyqLnuwaWMHajcU3oZ9uZezR.jpg"},{"name":"ماثيو ماكونهي","character":"Mark Hanna","profile_image":"https://image.tmdb.org/t/p/w185/lCySuYjhXix3FzQdS4oceDDrXKI.jpg"},{"name":"كايل تشاندلر","character":"Agent Patrick Denham","profile_image":"https://image.tmdb.org/t/p/w185/66n7XNj1dyYkzCBWR3Lq8Vz4PJ1.jpg"},{"name":"روب راينر","character":"Max Belfort","profile_image":"https://image.tmdb.org/t/p/w185/2nxxxj3aIU35eCOUEFBD0ireEhZ.jpg"},{"name":"جون بيرنثال","character":"Brad","profile_image":"https://image.tmdb.org/t/p/w185/bjcglF1IpDcZNs1HwFxakGpzBo6.jpg"},{"name":"جون فافرو","character":"Manny Riskin","profile_image":"https://image.tmdb.org/t/p/w185/8MtRRnEHaBSw8Ztdl8saXiw1egP.jpg"},{"name":"جان دوجردان","character":"Jean Jacques Saurel","profile_image":"https://image.tmdb.org/t/p/w185/iPtSWWoO8vajj6fIUQLQeuGOCsk.jpg"},{"name":"جوانا لوملي","character":"Aunt Emma","profile_image":"https://image.tmdb.org/t/p/w185/omQvLqkQf9yemMroaj6MJbf37sf.jpg"}],"trailer_url":"https://www.youtube.com/watch?v=Slj4-Sv-YNA","seasons_count":null,"episodes_count":null,"all_airings":[{"channel_id":"MoviesThriller.sa@SD","start":"2026-11-20T23:36:50Z","stop":"2026-11-21T02:16:50Z","start_ts":1795217810,"stop_ts":1795227410,"season":null,"episode":null},{"channel_id":"MoviesThriller.sa@SD","start":"2026-11-21T07:21:50Z","stop":"2026-11-21T10:01:50Z","start_ts":1795245710,"stop_ts":1795255310,"season":null,"episode":null}]},"mv19595":{"show_id":"mv19595","tmdb_id":19595,"content_type":"animation","title":"Shark Bait","title_en":null,"title_fr":"Festin de requin","original_title":null,"tagline":null,"description":"عندما تسرق مجموعة من الأصدقاء اثنين من الزلاجات النفاثة وينطلقون بها إلى البحر، ينتهي بهم الأمر في حادث مروع ويكافحون للعودة إلى البر.","description_en":"After losing everything, a young fish, Pi, goes to live with his family on the Reef. There he meets the love of his life but finds that she already has the unwanted affections of a bully shark. He must follow his destiny to save her and rid the Reef of this menace for good.","description_fr":"Séparé de ses parents emportés dans les filets des pêcheurs, le jeune poisson Po est conduit par des amis marsouins chez sa tante Pearl, qui habite un immense récif. Rendu à l'âge adulte, Po tombe sous le charme de Cordelia, poisson vedette qui pose pour les photographes, et parvient à conquérir son cœur. Ce qui soulève l'ire du vilain Troy, un requin-tigre qui convoite la belle et qui terrorise tout le monde. Pour éviter que le vil squale ne terrasse son petit ami, Cordelia promet à Troy de l'épouser. Po décide alors d'affronter son rival et recourt aux précieux conseils de Nerissa, une tortue centenaire réputée pour ses dons particuliers.","poster":"https://image.tmdb.org/t/p/w500/xmFSuoUfA1t4xsGKFR6i4kFvmWM.jpg","backdrop":"https://image.tmdb.org/t/p/w780/wjluPJYlI0cJxi55Z1nkyGJ8SGZ.jpg","has_poster":true,"rating":4.9,"vote_count":267,"age_rating":"G","year":"2006","release_date":"2006-07-07","runtime_minutes":77,"status":"Released","country":"كوريا الجنوبية","language":"الإنجليزية","genres":["رسوم متحركة","عائلي","إثارة","رعب"],"genre_keys":["animation","family","thriller","horror"],"similar":["mv129","tv15260","tv51817","mv9479","tv62211","tv29452","mv774370","tv44593"],"director":"Howard E. Baker, Kyung Ho Lee","cast":[{"name":"Freddie Prinze Jr.","character":"Pi (voice)","profile_image":"https://image.tmdb.org/t/p/w185/8V9yNBjCNRBKROyjCLKLJGcCBdG.jpg"},{"name":"Rob Schneider","character":"Nerissa (voice)","profile_image":"https://image.tmdb.org/t/p/w185/nGHHon86e0rxVV1GVMRuKheqf6L.jpg"},{"name":"إيفان رايتشل وود","character":"Cordelia (voice)","profile_image":"https://image.tmdb.org/t/p/w185/oVp8ctWKjskREG5bPoMGL1NOGdt.jpg"},{"name":"Donal Logue","character":"Troy (voice)","profile_image":"https://image.tmdb.org/t/p/w185/5Rj850yVkIqsgCihtZLbkNSHbFb.jpg"},{"name":"Andy Dick","character":"Dylan / Curious Shark (voice)","profile_image":"https://image.tmdb.org/t/p/w185/n4WT4oYoYrzSGAanlWPsneCzBPk.jpg"},{"name":"فران دريشر","character":"Pearl (voice)","profile_image":"h