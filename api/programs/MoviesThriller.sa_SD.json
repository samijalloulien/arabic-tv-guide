eason":null,"episode":null}]},"mv446791":{"show_id":"mv446791","tmdb_id":446791,"content_type":"movie","title":"All The Money In The World","title_en":null,"title_fr":"Tout l'Argent du Monde","original_title":null,"tagline":"كان لدى J.Paul Getty ثروة. دفع الجميع الثمن.","description":"عندما يتم اختطاف ابنها المراهق، تدخل غايل في سباق مع الوقت لإقناع جده الطماع بدفع الفدية.","description_en":"The story of the kidnapping of 16-year-old John Paul Getty III and the desperate attempt by his devoted mother to convince his billionaire grandfather Jean Paul Getty to pay the ransom.","description_fr":"Rome, 1973. Des hommes masqués kidnappent Paul, le petit-fils de J. Paul Getty, un magnat du pétrole connu pour son avarice, mais aussi l'homme le plus riche du monde.  Pour le milliardaire, l'enlèvement de son petit-fils préféré n'est pas une raison suffisante pour qu’il se sépare d’une partie de sa fortune.  Gail, la mère de Paul, femme forte et dévouée, va tout faire pour obtenir la libération de son fils. Elle s’allie à Fletcher Chace, le mystérieux chef de la sécurité du milliardaire et tous deux se lancent dans une course contre la montre face à des ravisseurs déterminés, instables et brutaux.","poster":"https://image.tmdb.org/t/p/w500/q6nE9Hf0ezszjI4DbCxwzQ73MMy.jpg","backdrop":"https://image.tmdb.org/t/p/w780/wJLTRnFKAVDDD7ci2L1eVnNJ7aI.jpg","has_poster":true,"rating":6.5,"vote_count":2499,"age_rating":"R","year":"2017","release_date":"2017-12-21","runtime_minutes":132,"status":"Released","country":"الولايات المتحدة","language":"الإنجليزية","genres":["جريمة","تاريخ","إثارة","دراما"],"genre_keys":["crime","history","thriller","drama"],"similar":["mv106646","mv14574","mv637649","mv1949","mv80278","mv338766","mv396371","mv11636"],"director":"ريدلي سكوت","cast":[{"name":"ميشيل وليمز","character":"Gail Harris","profile_image":"https://image.tmdb.org/t/p/w185/jn3BVMVbIptz2gc6Fhxo1qwJVvW.jpg"},{"name":"مارك والبيرغ","character":"Fletcher Chase","profile_image":"https://image.t