]},"shows":{"mv401":{"tmdb_id":401,"content_type":"movie","title":"Garden State","original_title":null,"description":"يعاني (أندرو لارجمان) الممثل التلفزيوني المتواضع من بعض المشاكل النفسية، بسبب اعتقاده أنه تسبب في حادث أقعد أمه طيلة حياتها؛ مما تسبب له في عقدة نفسية، جعلته يتناول عديدًا من الأدوية النفسية، التي تغير وجهة نظره للحياة، فيتغرب عن أسرته لعشر سنوات، ويعود في جنازة والدته، ويقرر التوقف عن تعاطي الأدوية التي تغير من حالته، ويبدأ في رؤية الحياة بشكل جديد، ويتعرف على فتاة جميلة، لديها مشاكلها الخاصة، ويبدآن حياتهما معًا بشكل جديد.","poster":"https://image.tmdb.org/t/p/w500/h3iqYiGS6F3y7GxaS4AT8nFxZ2i.jpg","backdrop":"https://image.tmdb.org/t/p/w780/2mu6XkJE0B6nK5jeOvXOyWPVmhw.jpg","has_poster":true,"rating":7.1,"vote_count":2155,"age_rating":"R","year":"2004","country":"الولايات المتحدة","language":"الإنجليزية","genres":["كوميديا","دراما","رومنسية"],"director":"زاك براف","cast":[{"name":"زاك براف","character":"Andrew Largeman","profile_image":"https://image.tmdb.org/t/p/w185/koIHwqE6hWIXuOIDHNADwSuGq6N.jpg"},{"name":"ناتالي بورتمان","character":"Sam","profile_image":"https://image.tmdb.org/t/p/w185/edPU5HxncLWa1YkgRPNkSd68ONG.jpg"},{"name":"إيان هولم","character":"Gideon Largeman","profile_image":"https://image.tmdb.org/t/p/w185/cOJDgvgj4nMec6Inzj1H5nugTO5.jpg"},{"name":"بيتر سارسجارد","character":"Mark","profile_image":"https://image.tmdb.org/t/p/w185/5UANyM4co2nwYPgSEmGeNlZRm7V.jpg"},{"name":"Jean Smart","character":"Carol","profile_image":"https://image.tmdb.org/t/p/w185/gOvEAOtrtedfgS7oQvPgHuJV4F8.jpg"},{"name":"أرماندو ريسكو","character":"Jesse","profile_image":"https://image.tmdb.org/t/p/w185/p6lYNZPYmyW83dgW43bhuvkFIRv.jpg"}],"trailer_url":"https://www.youtube.com/watch?v=u82n0e1mgmQ","seasons_count":null,"episodes_count":null,"all_airings":[{"channel_id":"StarMoviesMiddleEast.ae@SD","start":"2026-11-16T13:50:00Z","stop":"2026-11-16T15:25:00Z","start_ts":1794837000,"stop_ts":1794842700,"season":null,"episode":null}]},"xd21150e582":{"tmdb_id":null,"c