ler_url":"https://www.youtube.com/watch?v=dLw2sfQrhcQ","seasons_count":null,"episodes_count":null,"all_airings":[{"channel_id":"MoviesAction.sa@SD","start":"2026-11-26T18:03:08Z","stop":"2026-11-26T19:48:08Z","start_ts":1795716188,"stop_ts":1795722488,"season":null,"episode":null},{"channel_id":"MoviesAction.sa@SD","start":"2026-11-27T01:03:08Z","stop":"2026-11-27T02:48:08Z","start_ts":1795741388,"stop_ts":1795747688,"season":null,"episode":null},{"channel_id":"MoviesAction.sa@SD","start":"2026-11-27T08:03:08Z","stop":"2026-11-27T09:48:08Z","start_ts":1795766588,"stop_ts":1795772888,"season":null,"episode":null}]},"mv522931":{"show_id":"mv522931","tmdb_id":522931,"content_type":"movie","title":"Hitman's Wife's Bodyguard","title_en":null,"title_fr":"Hitman & Bodyguard 2","original_title":null,"tagline":null,"description":"الفريق قد عاد. الطيب. والشرس. والجميلة المجنونة.","description_en":"The world’s most lethal odd couple – bodyguard Michael Bryce and hitman Darius Kincaid – are back on another life-threatening mission. Still unlicensed and under scrutiny, Bryce is forced into action by Darius's even more volatile wife, the infamous international con artist Sonia Kincaid. As Bryce is driven over the edge by his two most dangerous protectees, the trio get in over their heads in a global plot and soon find that they are all that stand between Europe and a vengeful and powerful madman.","description_fr":"Michael Bryce, le célèbre garde du corps, a besoin de repos. Il décide d’entamer un \" voyage spirituel \" en Italie, loin des armes et de la violence. C’est à Capri que Sonia, la femme de Darius Kincaid, vient le chercher pour qu’il l’aide à libérer son mari des griffes de Carlo, un caïd mafieux. Michael accepte – à condition de ne toucher à aucune arme à feu… Ils infiltrent le QG de l’organisation criminelle, faisant échouer au passage une opération de surveillance des autorités, ce qui va leur attirer un autre genre d’ennuis… Le trio va vite se retrouver au cœur d’un chassé-croisé rempli de criminels et d’officiels qui ont tous d’excellentes raisons de leur en vouloir. Est-il vraiment possible de sauver sa peau et le monde sans tirer un seul coup de feu ?","poster":"https://image.tmdb.org/t/p/w500/mVElZVmxSE7jlfSLoPJNB6P8CaB.jpg","backdrop":"https://image.tmdb.org/t/p/w780/bjIPzixuWnOzxDG25WaXKuy9lYZ.jpg","has_poster":true,"rating":6.6,"vote_count":2761,"age_rating":"R","year":"2021","release_date":"2021-06-14","runtime_minutes":117,"status":"Released","country":"الولايات المتحدة","language":"الإنجليزية","genres":["حركة","كوميديا","جريمة","إثارة","أكشن","كوميدي"],"genre_keys":["action","comedy","crime","thriller"],"similar":["mv617502","mv457335","mv91550","mv8860","mv393","mv603692","mv207703","mv38234"],"director":"باتريك هيوز","cast":[{"name":"رايان رينولدز","character":"Michael Bryce","profile_image":"https://image.tmdb.org/t/p/w185/trzgptffGvAlAT6MEu01fz47cLW.jpg"},{"name":"صامويل جاكسون","character":"Darius Kincaid","profile_image":"https://image.tmdb.org/t/p/w185/AiAYAqwpM5xmiFrAIeQvUXDCVvo.jpg"},{"name":"سلمى حايك","character":"Sonia Kincaid","profile_image":"https://image.tmdb.org/t/p/w185/3j8MpAjyopkAc8mbNiDeXyqBmcS.jpg"},{"name":"أنتونيو بانديراس","character":"Aristotle Papdopolous","profile_image":"https://image.tmdb.org/t/p/w185/lpzfDt22374NPhOXZpUq74e9mfw.jpg"},{"name":"مورغان فريمان","character":"Senior","profile_image":"https://image.tmdb.org/t/p/w185/jPsLqiYGSofU4s6BjrxnefMfabb.jpg"},{"name":"فرانك جريلو","character":"Bobby O'Neill","profile_image":"https://image.tmdb.org/t/p/w185/kuEco4vo1xrsM8DyrNSZUEi593P.jpg"},{"name":"كارولين جودال","character":"Crowley","profile_image":"https://image.tmdb.org/t/p/w185/4cagGtMqACvkuw6Llq8Li8UJ1AR.jpg"},{"name":"Rebecca Front","character":"Therapist","profile_image":"https://image.tmdb.org/t/p/w185/nRyl1ayLbJ7hlbt15SvIIcVv49Q.jpg"},{"name":"Gabriella Wright","character":"Veronika","profile_image":"https://image.tmdb.org/t/p/w185/gRu9HvASbIceRNvQU43pvKyYc0l.jpg"},{"name":"A