 policier se retrouve pris au piège dans un braquage de banque. Il va tout faire pour stopper ces criminels surarmés et sauver les otages.","poster":"https://image.tmdb.org/t/p/w500/81RColr4rau6DZ7z9eMsksokcfk.jpg","backdrop":"https://image.tmdb.org/t/p/w780/7eTWQb475pM9H3NEOiUzGYASEx0.jpg","has_poster":true,"rating":5.2,"vote_count":512,"age_rating":"R","year":"2018","release_date":"2018-05-30","runtime_minutes":87,"status":"Released","country":"الولايات المتحدة","language":"الإنجليزية","genres":["جريمة","حركة","إثارة","أكشن","دراما"],"genre_keys":["crime","action","thriller","drama"],"similar":["mv14194","mv2207","mv247","mv338766","mv859","mv59967","mv811592","mv467632"],"director":"York Alec Shackleton","cast":[{"name":"نيكولاس كيج","character":"Mike Chandler","profile_image":"https://image.tmdb.org/t/p/w185/y1RtezurZYveYkVNRht7CwEgSYY.jpg"},{"name":"Sophie Skelton","character":"Lisa MacAvoy","profile_image":"https://image.tmdb.org/t/p/w185/oBkearm8XdrYTEK0VCWCGmwURt6.jpg"},{"name":"Michael Rainey Jr.","character":"Kenny","profile_image":"https://image.tmdb.org/t/p/w185/5U6wNx2LAggfwK6gi6OYL3rGOvl.jpg"},{"name":"Dwayne Cameron","character":"Steve MacAvoy","profile_image":"https://image.tmdb.org/t/p/w185/jUXYK8H91rpwa0yziq9KH6DUOeS.jpg"},{"name":"Weston Cage","character":"Luke","profile_image":"https://image.tmdb.org/t/p/w185/x6m7cjArcwxUps004Iuk1v6yQXF.jpg"},{"name":"Cory Hardrict","character":"Hanson","profile_image":"https://image.tmdb.org/t/p/w185/9pSvoahc7yDzTlogKddPglcVI2g.jpg"},{"name":"אורי פפר","character":"Tre","profile_image":"https://image.tmdb.org/t/p/w185/uUkL9Y9LJJJiiRUCK8yKaKZaXtc.jpg"},{"name":"Amanda Cerny","character":"Sarah","profile_image":"https://image.tmdb.org/t/p/w185/xBqqPm7dKF7pdQxKSumCW81skaU.jpg"},{"name":"Michael Bellisario","character":"Hyde","profile_image":"https://image.tmdb.org/t/p/w185/cOYBcJneNpmoJQQjRufP0lWO9l3.jpg"},{"name":"Mark Basnight","character":"Police Chief","profile_image":"https://image.tmdb.org/t/p/w185/77mFsuiD