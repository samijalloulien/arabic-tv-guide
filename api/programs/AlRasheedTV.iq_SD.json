8.jpg","backdrop":"https://image.tmdb.org/t/p/w780/3T8B6ZFtIf3bFHOYZCeedybEFRL.jpg","has_poster":true,"rating":null,"vote_count":null,"age_rating":null,"year":"1979","release_date":"1979-10-09","runtime_minutes":24,"status":"Ended","country":"اليابان","language":"اليابانية","genres":["رسوم متحركة"],"genre_keys":["animation"],"similar":["tv65930","tv57706","tv15260","tv73223","tv51817","tv4686","tv68073","mv1175942"],"director":null,"cast":[{"name":"松岡洋子","character":"Sarutobi Sasuke","profile_image":"https://image.tmdb.org/t/p/w185/bCz1mhZezCwmwWT93tDuuwVbrH4.jpg"},{"name":"西尾徳","character":"Kiyomi priest Miyoshi","profile_image":null},{"name":"橋本晃一","character":"Saizo Kirigakure","profile_image":"https://image.tmdb.org/t/p/w185/AURtsY0sQ82WgMgOlMGtqyTZ3z.jpg"},{"name":"のざききいこ","character":"Sakura","profile_image":null},{"name":"佐々木るん","character":"Yukino Princess","profile_image":"https://image.tmdb.org/t/p/w185/5iPnXjtsNINeHdkaOaWsa2MVNy3.jpg"},{"name":"飯塚昭三","character":"Hattori Hanzo","profile_image":"https://image.tmdb.org/t/p/w185/msqe5A1q5YUUND0RhzB9dw1AEAO.jpg"},{"name":"勝田久","character":"Koumura Shinda","profile_image":"https://image.tmdb.org/t/p/w185/nrW3rbsBytJmdDgQqBwdvV7Kwnx.jpg"},{"name":"勝田久","character":"Yukimura Sanada","profile_image":"https://image.tmdb.org/t/p/w185/nrW3rbsBytJmdDgQqBwdvV7Kwnx.jpg"},{"name":"飯塚昭三","character":"Michihito Maryu","profile_image":"https://image.tmdb.org/t/p/w185/msqe5A1q5YUUND0RhzB9dw1AEAO.jpg"}],"trailer_url":"https://www.youtube.com/watch?v=7BPRWx55oFs","seasons_count":1,"episodes_count":24,"all_airings":[{"channel_id":"AlRasheedTV.iq@SD","start":"2026-11-17T14:00:00Z","stop":"2026-11-17T14:20:00Z","start_ts":1794924000,"stop_ts":1794925200,"season":null,"episode":null}]},"tv47480":{"show_id":"tv47480","tmdb_id":47480,"content_type":"animation","title":"The Tom and Jerry Show","title_en":null,"title_fr":"Tom et Jerry Show","original_title":null,"tagline":null,"description":"مطاردات ومغامرات القط والفأر (توم وجيري) وأصدقائهما التي لا تنتهي في إطار خيالي كوميدي.","description_en":"The iconic cat and mouse rivals are back in a fresh take on the classic series. Preserving the look, characters and sensibility of the original, this series shines a brightly colored, high-definition lens on the madcap slapstick and never-ending battle that has made Tom and Jerry two of the most beloved characters of all time.","description_fr":"Le chat et la souris, rivaux emblématiques, sont de retour dans The Tom and Jerry Show, une nouvelle version de la série classique. Préservant le look, les personnages et la sensibilité de l'original, la toute nouvelle série haute définition met en scène la bataille sans fin qui a fait de Tom et Jerry deux des personnages les plus aimés de tous les temps.","poster":"https://image.tmdb.org/t/p/w500/41EWXLXTZO4MLb2BL28mWZuydyq.jpg","backdrop":"https://image.tmdb.org/t/p/w780/utqCOvMmjjMTlXNZz6PHOzRM5QP.jpg","has_poster":true,"rating":7.4,"vote_count":136,"age_rating":"TV-PG","year":"2014","release_date":"2014-04-09","runtime_minutes":7,"status":"Ended","country":"الولايات المتحدة","language":"الإنجليزية","genres":["عائلي","رسوم متحركة","كوميديا","أطفال","مسلسل - رسوم متحركة"],"genre_keys":["family","animation","comedy","kids"],"similar":["tv51817","tv4686","tv68073","tv64198","tv2530","tv67424","tv2437","tv64389"],"director":null,"cast":[{"name":"Rick Zieff","character":"Spike (voice)","profile_image":"https://image.tmdb.org/t/p/w185/6IeosfWH2rQyLF8gF1v2FfY5Q9T.jpg"},{"name":"Kath Soucie","character":"Tuffy (voice)","profile_image":"https://image.tmdb.org/t/p/w185/dSE1JtsdA1aSgIIw415bsXtmkPg.jpg"},{"name":"غراي ديلايل","character":"Ginger (voice)","profile_image":"https://image.tmdb.org/t/p/w185/anib3yRL9GyUvTkYNHWxQPlXLUH.jpg"},{"name":"Stephen Stanton","character":"Rick (voice)","profile_image":"https://image.tmdb.org/t/p/w185/kAz8Ja6SdB2gzabQEgMG2Hb1H5w.jpg"},{"name":"Joey D'Auria","character":"Butch / Droopy (voice)","profile_image":"https://image.tmdb.org/t/