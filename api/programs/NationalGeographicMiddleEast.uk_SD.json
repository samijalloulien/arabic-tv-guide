osphère angoissante et un suspense haletant. Interventions des survivants et des parents de victimes, explications d’experts, étude de la boîte noire de l'avion, rapports des autorités… Un important travail d'enquête a été mené afin de tenter de comprendre les raisons de ces crashes.","poster":"https://image.tmdb.org/t/p/w500/2uuVIAb4MtPmMNTpOyID5V8DzrU.jpg","backdrop":"https://image.tmdb.org/t/p/w780/vqm22ecqtzy5Olr74mkUV5lWa9g.jpg","has_poster":true,"rating":8.2,"vote_count":297,"age_rating":"TV-14","year":"2003","release_date":"2003-09-03","runtime_minutes":46,"status":"Returning Series","country":"كندا","language":"الإنجليزية","genres":["وثائقي","دراما","جريمة"],"genre_keys":["documentary","drama","crime"],"similar":["tv247718","tv259909","tv97951","tv8358","tv80748","tv4614","tv219826","tv115464"],"director":"Bernard Vaillot, André Barro","cast":[{"name":"Stephen Bogaert","character":"Self - Narrator (voice)","profile_image":"https://image.tmdb.org/t/p/w185/iEnR0LaAnlJBwE9gDlB5r0v4XIt.jpg"}],"trailer_url":"https://www.youtube.com/watch?v=es0qEPspoMg","seasons_count":26,"episodes_count":240,"all_airings":[{"channel_id":"NationalGeographicMiddleEast.uk@SD","start":"2026-11-24T09:30:00Z","stop":"2026-11-24T10:15:00Z","start_ts":1795512600,"stop_ts":1795515300,"season":null,"episode":null},{"channel_id":"NationalGeographicMiddleEast.uk@SD","start":"2026-11-24T10:15:00Z","stop":"2026-11-24T11:00:00Z","start_ts":1795515300,"stop_ts":1795518000,"season":null,"episode":null},{"channel_id":"NationalGeographicMiddleEast.uk@SD","start":"2026-11-24T15:00:00Z","stop":"2026-11-24T15:40:00Z","start_ts":1795532400,"stop_ts":1795534800,"season":null,"episode":null},{"channel_id":"NationalGeographicMiddleEast.uk@SD","start":"2026-11-24T15:40:00Z","stop":"2026-11-24T16:25:00Z","start_ts":1795534800,"stop_ts":1795537500,"season":null,"episode":null},{"channel_id":"NationalGeographicMiddleEast.uk@SD","start":"2026-11-25T00:00:00Z","stop":"2026-11-25T00:45:00Z","start_ts":1795564800