/o1YIVjaOroclA5TUOeYekqUmuCn.jpg","backdrop":"https://image.tmdb.org/t/p/w780/klD0xdA1iOepMe8qm708Lks4YAQ.jpg","has_poster":true,"rating":7.8,"vote_count":27,"age_rating":null,"year":"2025","release_date":"2025-09-25","runtime_minutes":67,"status":"Released","country":"الولايات المتحدة","language":"الإنجليزية","genres":["وثائقي","تاريخ"],"genre_keys":["documentary","history"],"similar":["mv159037","mv381284","mv106646","mv359724","mv374720","mv80278","mv855","mv396371"],"director":"Alex Kiehl","cast":[{"name":"Kathleen Martinez","character":"Self","profile_image":null},{"name":"زاهي حواس","character":"Self","profile_image":"https://image.tmdb.org/t/p/w185/lDZadqSZrcfDNy79w8nvWZL7cKW.jpg"},{"name":"Robert D. Ballard","character":"Self","profile_image":"https://image.tmdb.org/t/p/w185/wiNQa47si2jK6ODJ2Q0nMufqAky.jpg"},{"name":"Salima Ikram","character":"Self","profile_image":"https://image.tmdb.org/t/p/w185/oFsmRFgHMpBRk79G6d2CJBXt68s.jpg"}],"trailer_url":"https://www.youtube.com/watch?v=xhHxNLNJ_4o","seasons_count":null,"episodes_count":null,"all_airings":[{"channel_id":"NationalGeographicMiddleEast.uk@SD","start":"2026-11-25T08:30:00Z","stop":"2026-11-25T09:45:00Z","start_ts":1795595400,"stop_ts":1795599900,"season":null,"episode":null}]},"tv90":{"show_id":"tv90","tmdb_id":90,"content_type":"series","title":"تحقيقات الكوارث الجوية","title_en":"Mayday","title_fr":"Mayday : Dangers dans le ciel","original_title":"Mayday","tagline":null,"description":"برنامج تلفزيوني وثائقي من إنتاج Cineflix في كندا. وتم بثها على قناة ديسكفري وكندا، ومجلة ناشيونال جيوجرافيك. ويحقق هذا الفيلم الوثائقي في العديد من حوادث تحطم الطائرات في التاريخ الحديث بعد فحص الصندوق الأسود والاستماع لتسجيل الصندوقين الأسودين للطائرة. انه يكشف عن الأحداث التي أدت إلى كل من الكوارث، وأسباب الحوادث والتدابير الموصى بها في تقرير الهيئة القومية لسلامة الطيران، أو لمنع حدوث حادث مماثل مرة أخرى. انه ملامح لإعادة التشريعات، والمقابلات، والشهادات، وتوليد الصور الكمبيوتر، وبعض الحلقات، وقمرة القيادة وتسجيلات صوتية لإعادة تسلسل الأحداث إلى الجمهور.","description_en":"Major real-life air disasters are depicted in this series. Each episode features a detailed dramatized reconstruction of the incident based on cockpit voice recorders and air traffic control transcripts, as well as eyewitnesses recounts and interviews with aviation experts.","description_fr":"Cette série revient sur les grandes catastrophes aériennes. Ces films, mélange de reconstitutions et de témoignages, nous plongent dans une atmosphère angoissante et un suspense haletant. Interventions des survivants et des parents de victimes, explications d’experts, étude de la boîte noire de l'avion, rapports des autorités… Un important travail d'enquête a été mené afin de tenter de comprendre les raisons de ces crashes.","poster":"https://image.tmdb.org/t/p/w500/2uuVIAb4MtPmMNTpOyID5V8DzrU.jpg","backdrop":"https://image.tmdb.org/t/p/w780/vqm22ecqtzy5Olr74mkUV5lWa9g.jpg","has_poster":true,"rating":8.2,"vote_count":297,"age_rating":"TV-14","year":"2003","release_date":"2003-09-03","runtime_minutes":46,"status":"Returning Series","country":"كندا","language":"الإنجليزية","genres":["وثائقي","دراما","جريمة"],"genre_keys":["documentary","drama","crime"],"similar":["tv247718","tv259909","tv2288","tv97951","tv8358","tv80748","tv61056","tv210757"],"director":"Bernard Vaillot, André Barro","cast":[{"name":"Stephen Bogaert","character":"Self - Narrator (voice)","profile_image":"https://image.tmdb.org/t/p/w185/iEnR0LaAnlJBwE9gDlB5r0v4XIt.jpg"}],"trailer_url":"https://www.youtube.com/watch?v=es0qEPspoMg","seasons_count":26,"episodes_count":240,"all_airings":[{"channel_id":"NationalGeographicMiddleEast.uk@SD","start":"2026-11-25T09:45:00Z","stop":"2026-11-25T10:30:00Z","start_ts":1795599900,"stop_ts":1795602600,"season":null,"episode":null},{"channel_id":"NationalGeographicMiddleEast.uk@SD","start":"2026-11-25T10:30:00Z","stop":"2026-11-25T11:15:00Z","start_ts":1795602600,"stop_ts":1795605300,"season":null,"episode":null}]},"x503c418