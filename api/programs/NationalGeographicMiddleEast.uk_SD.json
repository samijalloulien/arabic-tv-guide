null,"status":null,"country":null,"language":null,"genres":[],"genre_keys":["documentary"],"similar":["mv513268","tv222311","x3a42e2e0e8","x6dec9ee478","x591337f1a7","x172d6fbfea","x688b084050","x82a67b4399"],"director":null,"cast":[],"trailer_url":null,"seasons_count":null,"episodes_count":null,"all_airings":[{"channel_id":"NationalGeographicMiddleEast.uk@SD","start":"2026-11-17T09:10:00Z","stop":"2026-11-17T09:30:00Z","start_ts":1794906600,"stop_ts":1794907800,"season":null,"episode":null},{"channel_id":"NationalGeographicMiddleEast.uk@SD","start":"2026-11-17T13:30:00Z","stop":"2026-11-17T14:00:00Z","start_ts":1794922200,"stop_ts":1794924000,"season":null,"episode":null}]},"tv90":{"show_id":"tv90","tmdb_id":90,"content_type":"series","title":"تحقيقات الكوارث الجوية","title_en":"Mayday","title_fr":"Mayday : Dangers dans le ciel","original_title":"Mayday","tagline":null,"description":"برنامج تلفزيوني وثائقي من إنتاج Cineflix في كندا. وتم بثها على قناة ديسكفري وكندا، ومجلة ناشيونال جيوجرافيك. ويحقق هذا الفيلم الوثائقي في العديد من حوادث تحطم الطائرات في التاريخ الحديث بعد فحص الصندوق الأسود والاستماع لتسجيل الصندوقين الأسودين للطائرة. انه يكشف عن الأحداث التي أدت إلى كل من الكوارث، وأسباب الحوادث والتدابير الموصى بها في تقرير الهيئة القومية لسلامة الطيران، أو لمنع حدوث حادث مماثل مرة أخرى. انه ملامح لإعادة التشريعات، والمقابلات، والشهادات، وتوليد الصور الكمبيوتر، وبعض الحلقات، وقمرة القيادة وتسجيلات صوتية لإعادة تسلسل الأحداث إلى الجمهور.","description_en":"Major real-life air disasters are depicted in this series. Each episode features a detailed dramatized reconstruction of the incident based on cockpit voice recorders and air traffic control transcripts, as well as eyewitnesses recounts and interviews with aviation experts.","description_fr":"Cette série revient sur les grandes catastrophes aériennes. Ces films, mélange de reconstitutions et de témoignages, nous plongent dans une atmosphère angoissante et un suspense haletant. Interventions des survivants et des parents de victimes, explications d’experts, étude de la boîte noire de l'avion, rapports des autorités… Un important travail d'enquête a été mené afin de tenter de comprendre les raisons de ces crashes.","poster":"https://image.tmdb.org/t/p/w500/2uuVIAb4MtPmMNTpOyID5V8DzrU.jpg","backdrop":"https://image.tmdb.org/t/p/w780/vqm22ecqtzy5Olr74mkUV5lWa9g.jpg","has_poster":true,"rating":8.2,"vote_count":297,"age_rating":"TV-14","year":"2003","release_date":"2003-09-03","runtime_minutes":46,"status":"Returning Series","country":"كندا","language":"الإنجليزية","genres":["وثائقي","دراما","جريمة"],"genre_keys":["documentary","drama","crime"],"similar":["tv247718","tv259909","tv97951","tv80748","tv4614","tv233686","tv219826","tv115464"],"director":"Bernard Vaillot, André Barro","cast":[{"name":"Stephen Bogaert","character":"Self - Narrator (voice)","profile_image":"https://image.tmdb.org/t/p/w185/iEnR0LaAnlJBwE9gDlB5r0v4XIt.jpg"}],"trailer_url":"https://www.youtube.com/watch?v=es0qEPspoMg","seasons_count":26,"episodes_count":240,"all_airings":[{"channel_id":"NationalGeographicMiddleEast.uk@SD","start":"2026-11-17T09:30:00Z","stop":"2026-11-17T10:15:00Z","start_ts":1794907800,"stop_ts":1794910500,"season":null,"episode":null},{"channel_id":"NationalGeographicMiddleEast.uk@SD","start":"2026-11-17T10:15:00Z","stop":"2026-11-17T11:00:00Z","start_ts":1794910500,"stop_ts":1794913200,"season":null,"episode":null},{"channel_id":"NationalGeographicMiddleEast.uk@SD","start":"2026-11-17T14:45:00Z","stop":"2026-11-17T15:00:00Z","start_ts":1794926700,"stop_ts":1794927600,"season":null,"episode":null}]},"xfb296b24f6":{"show_id":"xfb296b24f6","tmdb_id":null,"content_type":"documentary","title":"مهمة لانقاذ البحار","title_en":null,"title_fr":null,"original_title":null,"tagline":null,"description":"","description_en":"","description_fr":"","poster":null,"backdrop":null,"has_poster":false,"rating":null,"vote_count":null,"age_rating":null,"year":null,"release_date":null,"runtime_minutes":null,"sta