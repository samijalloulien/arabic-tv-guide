 they set off, and Osama went to the north, Al-Bashiq to the south, and Aqab went to the east","description_fr":"","poster":"https://image.tmdb.org/t/p/w500/srEXjZagpSTJpHWlliOHlqFKt5r.jpg","backdrop":"https://image.tmdb.org/t/p/w780/3f7VFiE53U4TAzjFoPbG1SEWT7c.jpg","has_poster":true,"rating":null,"vote_count":null,"age_rating":null,"year":null,"release_date":null,"runtime_minutes":null,"status":"Ended","country":"سوريا","language":"العربية","genres":["دراما","حركة ومغامرة"],"genre_keys":["drama","action"],"similar":["tv76773","tv2288","tv80748","tv88329","tv274556","tv74823","tv240558","tv67198"],"director":"هاني السعدي","cast":[{"name":"أسعد فضة","character":"ابن الوهاج","profile_image":"https://image.tmdb.org/t/p/w185/mMLzuU9aF7r2F57Hr7fmeXqy8k8.jpg"},{"name":"أيمن زيدان","character":"أسامة","profile_image":"https://image.tmdb.org/t/p/w185/dLtJROwks5s50yOJ06jDzp8h59.jpg"},{"name":"أمل عرفة","character":"العنقاء","profile_image":"https://image.tmdb.org/t/p/w185/cfd1sNg49Q663CQTB5XvhfgUGka.jpg"},{"name":"صباح عبيد","character":"الباشق","profile_image":"https://image.tmdb.org/t/p/w185/gi1uk8HgWd4s3Dohsz5Zu2zSKnV.jpg"},{"name":"عارف الطويل","character":"عقاب","profile_image":"https://image.tmdb.org/t/p/w185/hJjrlBa9FiaDkgB2IZWK10H8CgJ.jpg"},{"name":"Laila Jabr","character":"ريم","profile_image":"https://image.tmdb.org/t/p/w185/niHJJSUDZF8wlWeFH8bo6YlM1HO.jpg"},{"name":"حاتم علي","character":"شهاب","profile_image":"https://image.tmdb.org/t/p/w185/6ge72M1P9Pq3hMa4qYP7m2rxWBw.jpg"},{"name":"فرح بسيسو","character":"بثينة","profile_image":"https://image.tmdb.org/t/p/w185/9h8fs0ZKr0gWouRCfyxlsfd3T1n.jpg"},{"name":"توفيق اسكندر","character":"جراده","profile_image":null},{"name":"نورمان أسعد","character":"خولة","profile_image":"https://image.tmdb.org/t/p/w185/fHmX1PG3QIxErrgjh5ZYDdKntGt.jpg"}],"trailer_url":null,"seasons_count":1,"episodes_count":27,"all_airings":[{"channel_id":"DMCDrama.eg@SD","start":"2026-11-22T11:00:00Z","stop":"2026-11-22T12:00:00Z","start_ts":179534520