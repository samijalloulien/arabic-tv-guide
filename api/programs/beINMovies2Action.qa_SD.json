026-11-18T00:30:00Z","start_ts":1794955440,"stop_ts":1794961800,"season":null,"episode":null}]},"mv1465063":{"show_id":"mv1465063","tmdb_id":1465063,"content_type":"animation","title":"الجزيرة","title_en":"Forgotten Island","title_fr":"L'île des souvenirs","original_title":"Forgotten Island","tagline":null,"description":"في ليلتهما الأخيرة معًا بعد التخرج من الثانوية، تعثر صديقتان مقرّبتان ببوابة غامضة تنقلهما إلى جزيرة خيالية. وحين تكتشفان أن ثمن العودة إلى الديار هو ذكريات صداقتهما كلها، تسابقان الزمن لإيجاد طريق للخروج من الجزيرة قبل أن تنسى كل منهما الأخرى إلى الأبد.","description_en":"While celebrating their last night together, high school graduates and best friends Jo and Raissa stumble upon a mysterious portal that transports them to the fantastical island of Nakali. When they discover that the memories of their entire friendship are the price for returning home, Jo and Raissa must race to find a way to leave the island before they forget each other forever.","description_fr":"Pendant qu'elles passent une dernière soirée ensemble avant de s'engager sur des voies différentes, Jo et Raissa, amies depuis toujours, trouvent un portail mystérieux qui les transporte sur Nakali, une île mythique peuplée de créatures magiques dont leurs familles philippines leur ont parlé. Alors qu'elles cherchent à rentrer chez elles, Jo et Raissa découvrent que leurs souvenirs sont en péril. Réussiront-elles à quitter l'île avant de s'oublier l'une l'autre ?","poster":"https://image.tmdb.org/t/p/w500/qHltDXZZ24btJRqHZox56tKKinq.jpg","backdrop":"https://image.tmdb.org/t/p/w780/2o9FzuBzCqrDTdlHRuEVnGD2d5h.jpg","has_poster":true,"rating":8,"vote_count":262,"age_rating":"PG","year":"2026","release_date":"2026-09-10","runtime_minutes":109,"status":"Released","country":"الولايات المتحدة","language":"الإنجليزية","genres":["رسوم متحركة","مغامرة","فانتازيا","كوميديا","عائلي","أفلام"],"genre_keys":["animation","adventure","fantasy","comedy","family"],"similar":["tv64389","tv304593","tv15260","tv68073","tv62211","mv508422","tv92885","mv1287536"],"director":"Januel Mercado, Joel Crawford","cast":[{"name":"H.E.R.","character":"Jo (voice)","profile_image":"https://image.tmdb.org/t/p/w185/3OgApAmRJF6Y79HyHS1BZjNMgZd.jpg"},{"name":"لايزا سوبيرانو","character":"Raissa (voice)","profile_image":"https://image.tmdb.org/t/p/w185/xsgT139b39OHdLkY87yIabNLi5Y.jpg"},{"name":"ديف فرانكو","character":"Raww (voice)","profile_image":"https://image.tmdb.org/t/p/w185/nMROwyhekhgV5jU9TLQQAsjpNdw.jpg"},{"name":"Jenny Slate","character":"Batiba (voice)","profile_image":"https://image.tmdb.org/t/p/w185/mMxsNO6r966ut0sordYzj2iDOb6.jpg"},{"name":"ماني جاسينتو","character":"Bungi Tiyanak (voice)","profile_image":"https://image.tmdb.org/t/p/w185/jMbNV4nr5647r6CZJbT6nsnspMz.jpg"},{"name":"Lea Salonga","character":"Manang (voice)","profile_image":"https://image.tmdb.org/t/p/w185/cA8lv5GCU5DkZMEeplaVgttrlXr.jpg"},{"name":"دولي دي ليون","character":"Lola (voice)","profile_image":"https://image.tmdb.org/t/p/w185/fwwvPAJaJA3F8P35MYGf8MmYfe8.jpg"},{"name":"Jo Koy","character":"Datu (voice)","profile_image":"https://image.tmdb.org/t/p/w185/rbD9UnkYFYsmewSn2YFPI8lL5UI.jpg"},{"name":"روني تشينغ","character":"King Truffle Wuffle (voice)","profile_image":"https://image.tmdb.org/t/p/w185/yRUGjqALyg1LcJO75cO58cVJ2ud.jpg"},{"name":"Kevin McCann","character":"Prince Mermahn (voice)","profile_image":"https://image.tmdb.org/t/p/w185/tY9R5lQyA0vI7Bz6COiyyzOtkqJ.jpg"}],"trailer_url":"https://www.youtube.com/watch?v=PhgY8cOJiQA","seasons_count":null,"episodes_count":null,"all_airings":[{"channel_id":"beINMovies2Action.qa@SD","start":"2026-11-18T00:30:00Z","stop":"2026-11-18T02:15:00Z","start_ts":1794961800,"stop_ts":1794968100,"season":null,"episode":null}]},"mv634649":{"show_id":"mv634649","tmdb_id":634649,"content_type":"movie","title":"Spider-Man: No Way Home","title_en":null,"title_fr":null,"original_title":null,"tagline":"انطلقت عوالم الأكوان المتعددة.","description":"بعد أن تفضح هويته السرية، يلجأ بيتر باركر إلى دكتور ستراينج طالبا المساعدة. ولكن تسير تعويذتهما على نحو خاطئ، لتحطم الأكوان المتعددة وتجلب الأشرار المتوحشين.","description_en":"Peter Parker is unmasked and no longer able to separate his normal life from the high-stakes of being a super-hero. When he asks for help from Doctor Strange the stakes become even more dangerous, forcing him to discover what it truly means to be Spider-Man.","description_fr":"Après les événements liés à l'affrontement avec Mysterio, l'identité secrète de Spider-Man a été révélée. Il est poursuivi par le gouvernement américain, qui l'accuse du meurtre de Mysterio, et traqué par les médias. Cet événement a également des conséquences terribles sur la vie de sa petite-amie M.J. et de son meilleur ami Ned. Désemparé, Peter Parker demande alors de l'aide au docteur Strange. Ce dernier lance un sort pour que tout le monde oublie que Peter est Spider-Man. Mais les choses ne se passent pas comme prévu, et cette action altère la stabilité de l'espace-temps. Cela ouvre le « multivers », un concept terrifiant dont ils ne savent quasiment rien...","poster":"https://image.tmdb.org/t/p/w500/2maUA8Y4kxJ9UtLHYDhf9FSTd7u.jpg","backdrop":"https://image.tmdb.org/t/p/w780/iQFcwSGbZXMkeyKrxbPnwnRo5fl.jpg","has_poster":true,"rating":7.9,"vote_count":23578,"age_rating":"PG-13","year":"2021","release_date":"2021-12-15","runtime_minutes":148,"status":"Released","country":"الولايات المتحدة","language":"الإنجليزية","genres":["حركة","مغامرة","خيال علمي","أكشن","خيالي علمي"],"genre_keys":["action","adventure","scifi"],"similar":["mv429617","mv315635","mv1061474","mv912649","mv412656","mv121856","mv775","mv939243"],"director":"جون واتس","cast":[{"name":"توم هولاند","character":"Peter Parker / Spider-Man","profile_image":"https://image.tmdb.org/t/p/w185/xKBAaPIa1c7tzZD3Y0MhBLv4hPE.jpg"},{"name":"زيندايا","character":"MJ","profile_image":"https://image.tmdb.org/t/p/w185/1qup8tSt95HLbcy2c2xrx4iJNxv.jpg"},{"name":"بيندكت كامبرباتش","character":"Doctor 