is de Corto Maltese. Traversant une jungle qui grouille d'adversaires et de guerilleros à chaque tournant, l'Escouade est lancée dans une mission de recherche et de destruction, avec le seul Colonel Rick Flag pour les encadrer sur le terrain et la technologie du gouvernement dans leurs oreilles, afin qu'Amanda Waller puisse suivre le moindre de leurs mouvements.","poster":"https://image.tmdb.org/t/p/w500/xayv8vZgN3aoqy8ADWvPz8RJOE8.jpg","backdrop":"https://image.tmdb.org/t/p/w780/jlGmlFOcfo8n5tURmhC7YVd4Iyy.jpg","has_poster":true,"rating":7.4,"vote_count":10097,"age_rating":"R","year":"2021","release_date":"2021-07-28","runtime_minutes":132,"status":"Released","country":"الولايات المتحدة","language":"الإنجليزية","genres":["حركة","كوميديا","مغامرة","أكشن","مغامرات"],"genre_keys":["action","comedy","adventure"],"similar":["mv287947","mv1061474","mv1930","mv102382","mv412656","mv823625","mv209112","mv825997"],"director":"جيمس غان","cast":[{"name":"مارجو روبي","character":"Harley Quinn","profile_image":"https://image.tmdb.org/t/p/w185/euDPyqLnuwaWMHajcU3oZ9uZezR.jpg"},{"name":"إدريس إلبا","character":"Bloodsport","profile_image":"https://image.tmdb.org/t/p/w185/be1bVF7qGX91a6c5WeRPs5pKXln.jpg"},{"name":"جون سينا","character":"Peacemaker","profile_image":"https://image.tmdb.org/t/p/w185/rgB2eIOt7WyQjdgJCOuESdDlrjg.jpg"},{"name":"جويل كينمان","character":"Colonel Rick Flag","profile_image":"https://image.tmdb.org/t/p/w185/cVfYzTyQdJ4xtxKPZe7IcW3BJN4.jpg"},{"name":"سيلفستر ستالون","character":"King Shark (voice)","profile_image":"https://image.tmdb.org/t/p/w185/gn3pDWthJqR0VDYGViGD3048og7.jpg"},{"name":"فيولا ديفيس","character":"Amanda Waller","profile_image":"https://image.tmdb.org/t/p/w185/xDssw6vpYNRjsybvMPRE30e0dPN.jpg"},{"name":"ديفيد داستمالشيان","character":"Polka-Dot Man","profile_image":"https://image.tmdb.org/t/p/w185/eLafwcpL64CqzwjjSgKpO7Rv4ae.jpg"},{"name":"دانييلا ملشيور","character":"Ratcatcher 2","profile_image":"https://image.tmdb.org/t/p/w185/tjAEB90Sa7DJ