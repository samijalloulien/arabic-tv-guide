étés et d'espionnage qui la poussent à prendre la fuite et menacent sa vie. Elle est alors forcée d'épouser Jamie, un jeune guerrier écossais passionné qui s'enflamme pour elle et la conduit à être déchirée entre fidélité et désir, étant partagée entre deux hommes dramatiquement opposés et deux vies irréconciliables.","poster":"https://image.tmdb.org/t/p/w500/htXCyw8lcodCLG24cbwqf1NGJAg.jpg","backdrop":"https://image.tmdb.org/t/p/w780/nf3Vlxm3C9U1aKUUQHmKFZmxPSc.jpg","has_poster":true,"rating":8.2,"vote_count":3024,"age_rating":"TV-MA","year":"2014","release_date":"2014-08-09","runtime_minutes":null,"status":"Ended","country":"الولايات المتحدة","language":"الإنجليزية","genres":["دراما","خيال علمي وفانتازيا"],"genre_keys":["drama","scifi"],"similar":["tv103516","tv93740","tv67198","tv209419","tv71712","tv259909","tv61852","tv97951"],"director":"رونالد مور","cast":[{"name":"كاترينا بالف","character":"Claire Randall Fraser","profile_image":"https://image.tmdb.org/t/p/w185/lerCNTjO6FQIam2lF5SXHA4dY7H.jpg"},{"name":"سام هيوين","character":"Jamie Fraser","profile_image":"https://image.tmdb.org/t/p/w185/f35MnE74N2U0Dq6CVKwzF7DL8nN.jpg"},{"name":"Sophie Skelton","character":"Brianna MacKenzie","profile_image":"https://image.tmdb.org/t/p/w185/oBkearm8XdrYTEK0VCWCGmwURt6.jpg"},{"name":"Richard Rankin","character":"Roger MacKenzie","profile_image":"https://image.tmdb.org/t/p/w185/gmtK4zTBxlOEcHQgvXOwdfLHObc.jpg"},{"name":"John Bell","character":"Ian Fraser Murray","profile_image":"https://image.tmdb.org/t/p/w185/aPMEzcv36aAXyCLgsRkP0H2ezf6.jpg"},{"name":"David Berry","character":"Lord John Grey","profile_image":"https://image.tmdb.org/t/p/w185/hiuSdXFjI7EIMv8Y83zh2KtGbbk.jpg"},{"name":"Charles Vandervaart","character":"William Ransom","profile_image":"https://image.tmdb.org/t/p/w185/wo18r0IXjPhrybDFXHH6l68BeNW.jpg"},{"name":"Izzy Meikle-Small","character":"Rachel Murray","profile_image":"https://image.tmdb.org/t/p/w185/zQZyOJXQF8XApPRBoDJaasI3RHA.jpg"}],"trailer_url":"https://